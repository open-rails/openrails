{
  "name": "@openrails/billing-ui",
  "version": "0.0.0",
  "description": "Embeddable OpenRails purchase and account-billing UI: client, React hooks and styled components.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-rails/openrails.git",
    "directory": "sdk/billing-ui"
  },
  "homepage": "https://github.com/open-rails/openrails/tree/master/sdk/billing-ui#readme",
  "bugs": {
    "url": "https://github.com/open-rails/openrails/issues"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin.js"
    },
    "./admin.css": "./dist/admin.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "scripts": {
    "build": "vite build && vite build --config vite.admin.config.ts && node tooling/check-admin-entry.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm critical:build && cd ../.. && GOWORK=off go test -tags=integration -count=1 -p 2 -timeout 6m -run '^TestPublicSDK$' ./critical",
    "test:e2e": "pnpm test",
    "critical:build": "pnpm build && vite build --config critical/vite.config.ts && vite build --config critical/hosted/vite.config.ts && vite build --config critical/admin/vite.config.ts && tsc --noEmit --project critical/tsconfig.json",
    "critical:static": "pnpm typecheck && pnpm lint && tsc --noEmit --project critical/tsconfig.json && node critical/check-package.mjs",
    "contract": "cd ../.. && go run ./scripts/contracts -write",
    "contract:check": "cd ../.. && go run ./scripts/contracts",
    "format": "prettier --write \"**/*.{css,ts,tsx,json,md}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "@tanstack/react-query": ">=5 <6"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@basis-theory/web-elements": "^3.2.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@stripe/stripe-js": "^9.17.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.4.0",
    "zod": "^4.6.6",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react-grid-layout": "^2.2.3",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@solana/kit": "^6.10.0",
    "@solana/pay": "^1.0.26",
    "@solana/sysvars": "^5.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "@tanstack/react-query": "^5.101.4",
    "@openrails/auth-ui": "1.34.1",
    "react-router-dom": "7.18.2"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
