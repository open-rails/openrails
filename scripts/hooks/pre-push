#!/bin/sh
# Fast compile/generated-code guard before publishing a branch. The focused
# e2e suite is the only database/provider test lane.
set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

for module in . server examples; do
  (cd "$module" && GOWORK=off go build ./... && GOWORK=off go vet ./...)
done
bash scripts/check_business_time.sh
task sqlc-generate-check
