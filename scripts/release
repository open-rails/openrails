#!/usr/bin/env bash
# Releases the root, server and optional AuthKit adapter in lockstep. Master only
# accepts commits whose checks passed, so a release is two steps:
#
#   scripts/release prepare vX.Y.Z           # opens the release PR
#   scripts/release publish vX.Y.Z ["note"]  # once that PR is green
#
# prepare pins the server, AuthKit adapter and standalone test fixture to vX.Y.Z
# (replaces keep in-repository builds on local source) on origin/master, commits
# that to release/vX.Y.Z and opens its PR. publish fast-forwards master to the
# green PR head and pushes it with the signed, annotated vX.Y.Z and
# server/vX.Y.Z and adapters/authkit/vX.Y.Z tags at once. The vX.Y.Z tag runs release.yaml and
# docker-publish.yaml.
set -euo pipefail
die() {
  echo "release: $*" >&2
  exit 1
}
usage="usage: scripts/release prepare vX.Y.Z | publish vX.Y.Z [note]"
step="${1:-}"
version="${2:-}"
note="${3:-}"
[[ "$version" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$ ]] || die "$usage"
branch="release/$version"
cd "$(git rev-parse --show-toplevel)"
export GOWORK=off
git fetch --quiet origin master --tags
for tag in "$version" "server/$version" "adapters/authkit/$version"; do
  if git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; then
    die "$tag already exists"
  fi
done

case "$step" in
prepare)
  work="$HOME/cozy/.worktrees/openrails/release-$version"
  [[ ! -e "$work" ]] || die "$work already exists; resume its owned release work"
  mkdir -p "${work%/*}"
  git worktree add --quiet -b "$branch" "$work" origin/master
  admin="$(git -C "$work" rev-parse --absolute-git-dir)"
  python3 - "$admin/OWNER.json" "$branch" "$(git rev-parse origin/master)" "$work" <<'PY'
import json, sys
from pathlib import Path
Path(sys.argv[1]).write_text(json.dumps({
    "owner": "Paul Fidika", "purpose": "Prepare the paired OpenRails release",
    "branch": sys.argv[2], "base": sys.argv[3], "worktree": sys.argv[4],
}, indent=2) + "\n")
PY
  git -C "$work" config user.name 'Paul Fidika'
  git -C "$work" config user.email 'paul@fidika.com'
  for manifest in server/go.mod adapters/authkit/go.mod; do
    (cd "$work/${manifest%/go.mod}" && go mod edit -require="github.com/open-rails/openrails@$version" && go build -o /dev/null ./...)
  done
  # The real standalone fixture replaces both modules with this checkout.
  # Its requirements must still agree with the server's newly selected root;
  # otherwise release qualification asks for go mod tidy before tests can run.
  (cd "$work/critical/server-fixture" &&
    go mod edit -require="github.com/open-rails/openrails@$version" -require="github.com/open-rails/openrails/server@$version" &&
    go test -mod=readonly -c -p 2 -o "$admin/server-fixture.test" .)
  git -C "$work" commit --quiet -S -am "Release $version: pin server, adapter and test fixture to the paired root"
  git -C "$work" push --quiet origin "HEAD:refs/heads/$branch"
  gh pr create --base master --head "$branch" --title "Release $version" \
    --body "Pins server and AuthKit adapter to the paired root. When its checks pass: \`scripts/release publish $version\`."
  ;;
publish)
  git fetch --quiet origin "$branch"
  head="$(git rev-parse "origin/$branch")"
  git merge-base --is-ancestor origin/master "$head" || die "$branch is not ahead of origin/master; prepare it again"
  state="$(gh pr view "$branch" --json headRefOid,mergeStateStatus -q '.headRefOid + " " + .mergeStateStatus')"
  [[ "$state" == "$head CLEAN" ]] || die "the $branch PR is not green at $head ($state)"
  message="$version${note:+: $note}"
  git tag -s -a "$version" -m "$message" "$head"
  git tag -s -a "server/$version" -m "server/$message" "$head"
  git tag -s -a "adapters/authkit/$version" -m "adapters/authkit/$message" "$head"
  if ! git push --atomic origin "$head:refs/heads/master" "refs/tags/$version" "refs/tags/server/$version" "refs/tags/adapters/authkit/$version"; then
    git tag -d "$version" "server/$version" "adapters/authkit/$version" >/dev/null
    die "push refused; tags removed locally"
  fi
  # Preserve the owned release branch/worktree and its qualification receipts.
  echo "release: $version, server/$version and adapters/authkit/$version at ${head:0:9}"
  ;;
*)
  die "$usage"
  ;;
esac
