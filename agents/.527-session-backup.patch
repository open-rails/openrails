+		Users:       append([]authcore.BootstrapManifestUser(nil), m.Users...),
+		GlobalRoles: append([]authcore.BootstrapManifestGlobalRole(nil), m.GlobalRoles...),
+		Orgs:        make([]authcore.OrgManifestOrg, 0, len(m.Orgs)),
+	}
+	for _, org := range m.Orgs {
+		if len(org.APIKeys) > 0 && len(org.ServiceTokens) > 0 {
+			return authcore.BootstrapManifest{}, fmt.Errorf("auth org %q must not define both api_keys and service_tokens", strings.TrimSpace(org.Slug))
+		}
+		serviceTokens := org.ServiceTokens
+		if len(org.APIKeys) > 0 {
+			serviceTokens = org.APIKeys
+		}
+		out.Orgs = append(out.Orgs, authcore.OrgManifestOrg{
+			Slug:          org.Slug,
+			Issuers:       append([]authcore.OrgManifestIssuer(nil), org.Issuers...),
+			Roles:         append([]authcore.OrgManifestRole(nil), org.Roles...),
+			Memberships:   append([]authcore.OrgManifestMembership(nil), org.Memberships...),
+			ServiceTokens: append([]authcore.OrgManifestServiceToken(nil), serviceTokens...),
+		})
+	}
+	return out, nil
