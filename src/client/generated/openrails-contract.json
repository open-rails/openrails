        {
          "name": "id",
          "type": "string"
        },
        {
          "name": "rail",
          "type": "string"
        },
        {
          "name": "mode",
          "type": "string"
        },
        {
          "name": "driver",
          "type": "string"
        },
        {
          "name": "public_config",
          "type": "object",
          "optional": true
        }
      ]
    },
    {
      "name": "saved_methods",
      "type": "array",
      "optional": true,
      "fields": [
        {
          "name": "id",
          "type": "string"
        },
        {
          "name": "option_id",
          "type": "string"
        },
        {
          "name": "rail",
          "type": "string"
        },
        {
          "name": "brand",
          "type": "string",
          "optional": true
        },
        {
          "name": "last_four",
          "type": "string",
          "optional": true
        },
        {
          "name": "exp_month",
          "type": "number",
          "optional": true
        },
        {
          "name": "exp_year",
          "type": "number",
          "optional": true
        }
      ]
    },
    {
      "name": "transaction_url",
      "type": "string",
      "optional": true
    },
    {
      "name": "payment_id",
      "type": "string",
      "optional": true
    },
    {
      "name": "subscription_id",
      "type": "string",
      "optional": true
    },
    {
      "name": "failure_message",
      "type": "string",
      "optional": true
