# OpenRails environment variables. Copy to .env and fill in.
# Loads into the SAME config struct as config.example.yaml (which has full docs).
# Mapping rule: SECTION_FIELD -> section.field (the FIRST underscore becomes a dot),
# e.g. DB_URL -> db.url, CLICKHOUSE_HTTP_ADDR -> clickhouse.http_addr.
# Runtime config/env is infrastructure only. Merchant authority, provider
# credentials, branding, and catalog state are pushed with
# `openrails push-merchant-config` / `openrails push-merchant-catalog`.

# --- Core ---
ENV=development
MODE=full                      # full|limited|readonly; pure behavior dial, required outside dev
TEST_ENV=true                  # true = sandbox credentials enforced (Stripe test key, NMI probe, CCBill sandbox, Solana devnet); dev only
API_URL=https://api.example.com
HOST=0.0.0.0
PORT=2053

# --- Database (PostgreSQL) ---
DB_URL=postgres://admin:admin_password@localhost:25432/openrails_db?sslmode=disable
# Or atomic params (ignored if DB_URL is set):
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=openrails_db
DB_USERNAME=admin
DB_PASSWORD=admin_password
DB_SSLMODE=disable

# --- Redis ---
REDIS_ADDR=garnet:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Encryption at rest (#227) ---
# Master key wrapping per-tenant DEKs: base64 of 32 random bytes (from a KMS in
# prod; never the DB). Empty disables at-rest encryption.
ENCRYPTION_MASTER_KEY=

# --- Vault secret backend (optional) ---
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_AUTH_METHOD=token        # token | approle | kubernetes
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_K8S_ROLE=
VAULT_KV_MOUNT=secret
VAULT_TRANSIT_MOUNT=transit
VAULT_USE_TRANSIT_FOR_SOLANA=false
VAULT_SECRET_CACHE_TTL_SECONDS=900

# --- AuthKit control-plane infrastructure ---
AUTH_CONTROL_PLANE_ISSUER=

# --- Email (SendGrid) ---
SENDGRID_API_KEY=

# --- Analytics (ClickHouse) ---
CLICKHOUSE_HTTP_ADDR=http://clickhouse:8123
CLICKHOUSE_CLIENT_ADDR=clickhouse:9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_CLUSTER=billing
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# --- Logging ---
LOGGER_LEVEL=info              # debug | info | warn | error

# Provider credentials, webhook secrets, merchant branding, remote applications,
# users, service tokens, orgs, and permissions belong in the merchant config
# manifest, not .env:
#
# merchants:
#   - slug: local-stack
#     profile:
#       from_email: billing@local-stack.example
#     provider_accounts:
#       - provider_type: stripe
#         account_id: acct_123
#         secrets:
#           secret_key: {env: LOCAL_STACK_STRIPE_SECRET_KEY}

# --- USDC wallet funding: USDC_FUNDING_PROVIDERS_<NAME>_<FIELD> ---
# These create external Robinhood/Coinbase handoffs that fund the user's own
# wallet before normal Solana checkout.
USDC_FUNDING_PROVIDERS_ROBINHOOD_ENABLED=false
USDC_FUNDING_PROVIDERS_ROBINHOOD_LAUNCH_URL_TEMPLATE=
USDC_FUNDING_PROVIDERS_COINBASE_ENABLED=false
USDC_FUNDING_PROVIDERS_COINBASE_API_BASE_URL=https://api.cdp.coinbase.com
USDC_FUNDING_PROVIDERS_COINBASE_API_KEY_ID=
USDC_FUNDING_PROVIDERS_COINBASE_API_KEY_SECRET=
USDC_FUNDING_PROVIDERS_COINBASE_WEBHOOK_SECRET=
# Optional pre-generated short-lived bearer token escape hatch.
USDC_FUNDING_PROVIDERS_COINBASE_API_KEY=

# --- Captcha ---
CAPTCHA_PROVIDER=turnstile               # turnstile | recaptcha-v3 | hcaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
