# OpenRails environment variables. Copy to .env and fill in.
# Loads into the SAME config struct as config.example.yaml (which has full docs).
# Mapping rule: SECTION_FIELD -> section.field (the FIRST underscore becomes a dot),
# e.g. DB_URL -> db.url, CLICKHOUSE_HTTP_ADDR -> clickhouse.http_addr.
# Maps (tokens, price_feeds, rate_limits, tenant_cors, auth.control_plane) are
# yaml-only — set those in config.yaml.

# --- Core ---
ENV=development
TEST_MODE=true                 # true = sandbox/devnet; false = real production charges
API_URL=https://api.example.com
HOST=0.0.0.0
PORT=2053
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# --- Database (PostgreSQL) ---
DB_URL=postgres://admin:admin_password@localhost:25432/openrails_db?sslmode=disable
# Or atomic params (ignored if DB_URL is set):
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=openrails_db
# DB_USERNAME=admin
# DB_PASSWORD=admin_password
# DB_SSLMODE=disable

# --- Redis ---
# REDIS_ADDR=garnet:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- Encryption at rest (#227) ---
# Master key wrapping per-tenant DEKs: base64 of 32 random bytes (from a KMS in
# prod; never the DB). Empty disables at-rest encryption.
# ENCRYPTION_MASTER_KEY=

# --- Auth (JWT verifier) ---
AUTH_EXPECTED_AUDIENCE=openrails-app
# AUTH_ISSUERS=["http://localhost:28080"]   # JSON array or comma-separated

# --- Store / branding ---
# STORE_NAME=My Store
# STORE_LOGO_URL=https://your-domain.com/logo.png
# STORE_FROM_EMAIL=noreply@your-domain.com
# STORE_CUSTOMER_PORTAL_URL=https://your-domain.com/account

# --- Email (SendGrid) ---
# SENDGRID_API_KEY=

# --- Analytics (ClickHouse) ---
# CLICKHOUSE_HTTP_ADDR=http://clickhouse:8123
# CLICKHOUSE_CLIENT_ADDR=clickhouse:9000
# CLICKHOUSE_DB=analytics
# CLICKHOUSE_CLUSTER=billing
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=

# --- Logging ---
# LOGGER_LEVEL=info              # debug | info | warn | error

# --- Pyth price feeds ---
# PYTH_HERMES_URL=https://hermes.pyth.network
# PYTH_MAX_PRICE_AGE=2m
# PYTH_MAX_CONFIDENCE_BPS=100

# --- Payment processors: PROCESSORS_<NAME>_<FIELD> ---
# Solana
# PROCESSORS_SOLANA_RECIPIENT_WALLET=
# PROCESSORS_SOLANA_HELIUS_API_KEY=        # free at helius.dev; else Ankr/public fallback
# PROCESSORS_SOLANA_RPC_ENDPOINT=          # custom RPC (overrides fallback)
# PROCESSORS_SOLANA_NETWORK=mainnet        # else auto-derived from TEST_MODE
# Stripe
# PROCESSORS_STRIPE_SECRET_KEY=sk_test_...
# PROCESSORS_STRIPE_WEBHOOK_SECRET=whsec_...
# PROCESSORS_STRIPE_WEBHOOK_SECRET_THIN=whsec_...
# NMI-backed (reserved name "mobius", or any name with type=nmi)
# PROCESSORS_MOBIUS_SECURITY_KEY=
# PROCESSORS_MOBIUS_TOKENIZATION_KEY=
# PROCESSORS_MOBIUS_WEBHOOK_SECRET=
# CCBill
# PROCESSORS_CCBILL_SALT=
# PROCESSORS_CCBILL_CLIENT_ACC_NUM=
# PROCESSORS_CCBILL_CLIENT_SUB_ACC=

# --- USDC wallet funding: USDC_FUNDING_PROVIDERS_<NAME>_<FIELD> ---
# These create external Robinhood/Coinbase handoffs that fund the user's own
# wallet before normal Solana checkout.
# USDC_FUNDING_PROVIDERS_ROBINHOOD_ENABLED=false
# USDC_FUNDING_PROVIDERS_ROBINHOOD_LAUNCH_URL_TEMPLATE=
# USDC_FUNDING_PROVIDERS_COINBASE_ENABLED=false
# USDC_FUNDING_PROVIDERS_COINBASE_API_BASE_URL=https://api.cdp.coinbase.com
# USDC_FUNDING_PROVIDERS_COINBASE_API_KEY_ID=
# USDC_FUNDING_PROVIDERS_COINBASE_API_KEY_SECRET=
# USDC_FUNDING_PROVIDERS_COINBASE_WEBHOOK_SECRET=
# Optional pre-generated short-lived bearer token escape hatch.
# USDC_FUNDING_PROVIDERS_COINBASE_API_KEY=

# --- Feature flags ---
# FEATURE_FLAGS_DUNNING_MODE=on            # on | dry_run_only | off
# FEATURE_FLAGS_DISABLE_ENTITLEMENT_EXPIRATION=false
