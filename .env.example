# OpenRails environment variables. Copy to .env and fill in.
# Loads into the SAME config struct as config.example.yaml (which has full docs).
# Mapping rule: SECTION_FIELD -> section.field (the FIRST underscore becomes a dot),
# e.g. DB_URL -> db.url, REDIS_ADDR -> redis.addr.
# Runtime config/env is infrastructure only. Merchant authority, provider
# credentials, branding, and catalog state are pushed with
# `openrails push-auth-bootstrap` / `openrails push-merchant-config` /
# `openrails push-merchant-catalog`.
#
# This file is BOOTABLE and round-tripped by config/env_example_test.go
# (or#915): every uncommented var must route to a real config key (or be one
# of the declared docker-compose interpolation vars), and the file as a whole
# must pass config.Load. A var inside a known section that names no field
# (e.g. DB_TYPO) refuses boot — nothing here is silently dropped.

# --- Core ---
ENV=development
# provider_write_mode: full | limited | readonly; pure behavior dial, required outside dev.
PROVIDER_WRITE_MODE=full
# test_mode: sandbox | live. REQUIRED outside development (or#915) — the
# credential posture is never inherited by omission. sandbox enforces test
# credentials (Stripe test key, NMI probe, CCBill sandbox, Solana devnet).
TEST_MODE=sandbox
API_URL=http://localhost:3053
HOST=0.0.0.0
PORT=3053
# docker-compose interpolation only (host-side port mapping), not server config.
OPENRAILS_HOST_PORT=3053
# Minimum separation between equal post-absence provider-billing observations;
# defaults to 24h. PROVIDER_BILLING_QUIESCENCE_INTERVAL=24h

# --- Database (PostgreSQL) ---
# The server connects as openrails_app: unprivileged, NOBYPASSRLS, the same role
# production uses. Boot REFUSES a superuser/BYPASSRLS role in every environment,
# development included — dev has to exercise the real merchant-isolation
# boundary or it manufactures queries that silently return zero rows in prod.
# DB_ADMIN_PASSWORD belongs to the privileged `admin` role, which exists for
# `openrails migrate up` (and the compose bootstrap) ONLY — docker-compose
# interpolation, never server config.
POSTGRES_HOST_PORT=5434
DB_URL=postgres://openrails_app:openrails_app_password@localhost:5434/openrails_db?sslmode=disable
# Or atomic params (ignored if DB_URL is set):
DB_HOST=localhost
DB_PORT=5434
DB_DATABASE=openrails_db
DB_USERNAME=openrails_app
DB_PASSWORD=openrails_app_password
DB_ADMIN_PASSWORD=admin_password
DB_SSLMODE=disable

# --- Redis ---
GARNET_HOST_PORT=6380
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# --- Encryption at rest (#227) ---
# Master key wrapping per-tenant DEKs: base64 of 32 random bytes (from a KMS in
# prod; never the DB). Empty disables at-rest encryption.
ENCRYPTION_MASTER_KEY=

# --- Vault secret backend for merchant secrets (optional) ---
# This configures OpenRails' merchant secret store. It is separate from AuthKit
# JWT signing-key loading below.
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
# vault.auth_method: token | approle | kubernetes
VAULT_AUTH_METHOD=token
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_K8S_ROLE=

# --- AuthKit control-plane infrastructure ---
AUTH_ISSUER=http://localhost:3053
# Local direct connection; behind proxies use TRUSTED_PROXIES instead.
AUTH_DIRECT_PEER_IP=true
# Optional shared username/group policy; omitted values use AuthKit defaults.
# AUTH_NAMING_ENABLED=true
# AUTH_NAMING_RENAME_INTERVAL=72h
# AUTH_NAMING_FORMER_NAMES_MODE=finite
# AUTH_NAMING_FORMER_NAMES_DURATION=2160h
# For forever/immediate mode, leave duration unset.

# --- AuthKit/OpenRails JWT signing keys ---
# Production should inject keys at ${AUTHKIT_KEYS_PATH}/keys.json, typically via
# Vault Agent, External Secrets, or a platform secret mount. docker-compose.yaml
# mounts ${AUTHKIT_KEYS_HOST_DIR:-./.secrets/authkit} to /vault/auth
# (AUTHKIT_KEYS_HOST_DIR is compose interpolation only).
# Local development may leave this empty; AuthKit will generate and persist
# development keys under /.runtime/authkit.
AUTHKIT_KEYS_PATH=/vault/auth
AUTHKIT_KEYS_HOST_DIR=./.secrets/authkit
# Alternative env-based key source (AUTHKIT_-prefixed since ak#266/or#917,
# matching the authkit binary). AUTHKIT_ACTIVE_PRIVATE_KEY_PEM is usually
# awkward in .env files; prefer keys.json for real deployments.
AUTHKIT_ACTIVE_KEY_ID=
AUTHKIT_ACTIVE_PRIVATE_KEY_PEM=
AUTHKIT_PUBLIC_KEYS=

# --- Email (SendGrid) ---
SENDGRID_API_KEY=

# --- Logging ---
# logger.level: debug | info | warn | error
LOGGER_LEVEL=info

# --- Captcha ---
# captcha.provider: turnstile | recaptcha-v3 | hcaptcha
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- CLI attribution (read by the openrails CLI, not config.Load) ---
# OPENRAILS_ACTOR labels destructive CLI runs (converge/undo audit trail);
# unset falls back to SUDO_USER/USER/LOGNAME.
# OPENRAILS_ACTOR=
