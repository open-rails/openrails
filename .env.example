# Every environment variable the openrails binary reads: a reference, read by
# nothing. Generated from the configuration types; regenerate with
# `go run ./internal/examplegen -write` in server/. Each value is the default
# (empty: none) and each secret is empty. A variable is its config.yaml key,
# upper-cased and joined by "_"; a list is comma-separated, a section or a
# list of sections JSON. A variable inside a known section that names no key
# refuses boot. Policy (rate_limits, user_action_rate_limit,
# destructive_action_limits, auth.http.rate_limits) is set in config.yaml
# only. A merchant's settings are no variables: its document is
# merchant.example.yaml.

# --- process ---
# The configuration file when --config names none; also config/ is searched.
OPENRAILS_CONFIG=config.yaml
# The directory of mounted secret files, each named like its variable; vault.secrets_path defaults to it.
VAULT_SECRETS_PATH=/vault/secrets
# With DATABASE_URL unset, libpq's variables name the database: PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD or PGPASSFILE, PGSSLMODE (verify-full off this machine), PGSSLROOTCERT.
PGHOST=

# --- database ---
# Schema holds OpenRails' tables: a plain identifier.
DATABASE_SCHEMA=billing
# URL is the connection string.
DATABASE_URL=postgres://app:app_password@localhost:5434/openrails_db?sslmode=disable

# --- top level ---
# PublicURL is where browsers and PSPs reach billing: the external billing mount, excluding /v1.
PUBLIC_URL=
# TrustedProxies are the CIDRs whose X-Forwarded-For is trusted when resolving a client's address.
TRUSTED_PROXIES=
# CheckoutOrigin is needed only to serve OpenRails's own hosted pay page: the separate origin (https://pay.example.com) where /pay/<order> is served from Deps.CheckoutAssets; leave it empty when you use the embedded checkout or your own card form, and pay URLs then answer pay_url_unavailable.
CHECKOUT_ORIGIN=
# LocalSignIn serves sign-in to the server's own accounts (password, passwordless, registration).
LOCAL_SIGN_IN=false
# Port is where Run and Serve listen, on every interface.
PORT=3053
# MetricsPort is where Run and Serve also serve MetricsHandler, the operator's Prometheus /metrics, apart from the public surface.
METRICS_PORT=

# --- captcha ---
# Provider is "turnstile", "recaptcha-v3" or "hcaptcha".
CAPTCHA_PROVIDER=turnstile
# SiteKey is the account's public key, which the browser's widget loads.
CAPTCHA_SITE_KEY=
# SecretKey is the account's secret, which verifies a solved challenge.
CAPTCHA_SECRET_KEY=

# --- vault ---
# KVMount is the KV v2 mount merchant configuration lives in, under ScopePrefix.
VAULT_KV_MOUNT=
# ScopePrefix is the path under KVMount.
VAULT_SCOPE_PREFIX=openrails
# TransitMount is the Transit mount Solana signing keys live under.
VAULT_TRANSIT_MOUNT=transit
# Address is the server URL (VAULT_ADDR); empty is Vault's default, https://127.0.0.1:8200.
VAULT_ADDR=
# Namespace is a Vault Enterprise namespace.
VAULT_NAMESPACE=
# CACert is the path of the PEM bundle of the CA that signed Vault's certificate (VAULT_CACERT).
VAULT_CACERT=
# AuthMethod is "token", "approle" or "kubernetes".
VAULT_AUTH_METHOD=
# Token is a pre-issued Vault token.
VAULT_TOKEN=
# RoleID is the AppRole role id.
VAULT_ROLE_ID=
# SecretID is the AppRole secret id, when SecretsPath holds none.
VAULT_SECRET_ID=
# K8sRole is the kubernetes auth method's role.
VAULT_K8S_ROLE=
# AuthMount is where the approle or kubernetes auth method is mounted: the -path of `vault auth enable`, without auth/.
VAULT_AUTH_MOUNT=

# --- card_vault ---
# TenantID is the vendor's tenant id.
CARD_VAULT_TENANT_ID=
# KVMount holds the platform credential document.
CARD_VAULT_KV_MOUNT=

# --- hyperswitch ---
# APIBaseURL is the deployment's HyperSwitch API.
HYPERSWITCH_API_BASE_URL=
# SDKURL is the HyperSwitch browser SDK the payment page loads.
HYPERSWITCH_SDK_URL=

# --- solana ---
# Crankers sign Solana rebilling, in order: the first publishes new plans, and each pulls the renewals of the plans it owns, whose owner is fixed on-chain.
SOLANA_CRANKERS=

# --- auth ---
# SkipMigrations makes New validate existing schemas without applying DDL.
AUTH_DATABASE_SKIP_MIGRATIONS=false
# Schema is the PostgreSQL schema AuthKit's tables live in.
AUTH_DATABASE_SCHEMA=profiles
# RiverSchema holds the River tables AuthKit's jobs (account lifecycle, events, cleanup) run in; empty defaults to "public".
AUTH_DATABASE_RIVER_SCHEMA=
# AuthKit's auth.notifications.schema.
AUTH_NOTIFICATIONS_SCHEMA=
# Scopes explicitly adopts existing inbox namespaces by canonical tenant ID.
AUTH_NOTIFICATIONS_SCOPES=
# AppID fixes the HTTP inbox view to tenant-wide and this application's receipts.
AUTH_NOTIFICATIONS_APP_ID=
# LegacyOrigins explicitly admits unclassified receipts during adoption.
AUTH_NOTIFICATIONS_LEGACY_ORIGINS=
# Producers are trusted, fixed publication bindings.
AUTH_NOTIFICATIONS_PRODUCERS=
# Issuer is this deployment's JWT issuer (required), an https URL such as "https://myapp.com"; http only on a loopback host (localhost, 127.0.0.1, [::1]).
AUTH_TOKEN_ISSUER=
# IssuedAudiences are the audiences every issued token carries (at least one).
AUTH_TOKEN_ISSUED_AUDIENCES=
# ExpectedAudiences are the audiences verification accepts; empty defaults to IssuedAudiences.
AUTH_TOKEN_EXPECTED_AUDIENCES=
# AccessTokenDuration is the access-token lifetime; 0 defaults to 15 minutes, the longest a revoked session's token passes stateless checks.
AUTH_TOKEN_ACCESS_TOKEN_DURATION=
# RefreshTokenDuration is the refresh-session lifetime from sign-in: 0 defaults to 30 days; a negative value means sessions do not expire by age.
AUTH_TOKEN_REFRESH_TOKEN_DURATION=720h
# SessionMaxPerUser caps concurrent refresh sessions per user, evicting the oldest.
AUTH_TOKEN_SESSION_MAX_PER_USER=
# RefreshRotationGrace is how long a just-rotated refresh token keeps being answered with the successor it rotated into instead of being read as reuse and ending the session.
AUTH_TOKEN_REFRESH_ROTATION_GRACE=
# EntitlementAllowlist selects the provider-granted entitlement names (Deps.Entitlements) that access tokens carry.
AUTH_TOKEN_ENTITLEMENT_ALLOWLIST=
# AccountIssuers lists every issuer whose deployment shares this account store (the same Schema on the same database), e.g. two sites with separate logins over one set of accounts.
AUTH_TOKEN_ACCOUNT_ISSUERS=
# AllowPrivateNetworkJWKS permits http and private or loopback JWKS URLs for remote applications and the issuers verifiers trust, and turns off the SSRF guard on remote applications' JWKS URLs.
AUTH_TOKEN_ALLOW_PRIVATE_NETWORK_JWKS=false
# AccountsPerDevice caps the distinct accounts that sign in, or are registered, from one device in 24 hours.
AUTH_SIGN_IN_ACCOUNTS_PER_DEVICE=
# AccountsPerAddress is AccountsPerDevice for a client without a device cookie, counted per client address, which many people may share.
AUTH_SIGN_IN_ACCOUNTS_PER_ADDRESS=
# NewDevicesPerAccount caps the new devices that sign in to one account in 24 hours.
AUTH_SIGN_IN_NEW_DEVICES_PER_ACCOUNT=
# DPoP is how this deployment issues tokens to its own users (RFC 9449): their sign-in sessions and its authorization server's user grants.
AUTH_SIGN_IN_DPOP=
# Path is the directory holding keys.json (hot-reloaded on rotation) and totp.key.
AUTH_KEYS_PATH=/vault/auth
# VerifyOnly builds AuthKit with no signer: minting returns iam.ErrSigningNotConfigured, verification and permission reads work, and JWKS serves an empty set.
AUTH_KEYS_VERIFY_ONLY=false
# BaseURL builds absolute links (password reset, verification, invites).
AUTH_FRONTEND_BASE_URL=
# OIDCReturnPath is the SPA route AuthKit redirects to after it finishes a browser sign-in with an identity provider (not the provider callback, which AuthKit owns).
AUTH_FRONTEND_OIDC_RETURN_PATH=
# VerifyPath receives scanner-safe verification link landings.
AUTH_FRONTEND_VERIFY_PATH=
# PasswordResetPath receives scanner-safe password reset link landings.
AUTH_FRONTEND_PASSWORD_RESET_PATH=
# PasswordlessPath receives passwordless sign-in links.
AUTH_FRONTEND_PASSWORDLESS_PATH=
# InvitePath receives group invitation links (?code=…); the SPA posts the code to the redeem route.
AUTH_FRONTEND_INVITE_PATH=
# AuthorizePath receives an OAuth client's sign-in request (?authorization=…) when the authorization server is on: the SPA signs the user in, then approves the request through the API.
AUTH_FRONTEND_AUTHORIZE_PATH=
# Verification is "none" (the default), "optional" or "required".
AUTH_REGISTRATION_VERIFICATION=
# UnprovenPasswordSignIn lets existing accounts sign in with a password without proving their email or phone when Verification is "required".
AUTH_REGISTRATION_UNPROVEN_PASSWORD_SIGN_IN=false
# NativeUserMode controls public self-registration: "open" (the default), "invite_only" or "closed".
AUTH_REGISTRATION_NATIVE_USER_MODE=
# PasswordlessLogin enables contact-based passwordless sessions.
AUTH_REGISTRATION_PASSWORDLESS_LOGIN=false
# PasswordlessAutoRegistration lets a verified unknown contact create a passwordless account during passwordless confirmation.
AUTH_REGISTRATION_PASSWORDLESS_AUTO_REGISTRATION=false
# AllowMissingSenders lets flows that deliver codes and links proceed with no email or SMS sender: nothing is delivered and the engine hands the code back to its caller (dev rigs read it there).
AUTH_REGISTRATION_ALLOW_MISSING_SENDERS=false
# VerificationSendTimeout bounds each in-line email or SMS send so an unreachable provider cannot hang the request.
AUTH_REGISTRATION_VERIFICATION_SEND_TIMEOUT=
# Agreements are the keys of Config.Agreements every self-registration accepts at their current version: a sign-up by password, code or identity provider without them is refused with agreement_required, and a passwordless code stays valid for the retry that accepts them.
AUTH_REGISTRATION_AGREEMENTS=
# Agreements are the documents users accept, such as terms and a privacy policy, each at its current version.
AUTH_AGREEMENTS=
# AllowedCountries are the ISO 3166-1 alpha-2 regions text messages may go to, such as "US" and "CA"; a number elsewhere is refused with phone_country_not_allowed before anything is sent.
AUTH_SMS_ALLOWED_COUNTRIES=
# AuthKit's auth.password.min_length.
AUTH_PASSWORD_MIN_LENGTH=
# AuthKit's auth.password.max_length.
AUTH_PASSWORD_MAX_LENGTH=
# AuthKit's auth.password.require_uppercase.
AUTH_PASSWORD_REQUIRE_UPPERCASE=false
# AuthKit's auth.password.require_lowercase.
AUTH_PASSWORD_REQUIRE_LOWERCASE=false
# AuthKit's auth.password.require_digit.
AUTH_PASSWORD_REQUIRE_DIGIT=false
# AuthKit's auth.password.require_symbol.
AUTH_PASSWORD_REQUIRE_SYMBOL=false
# AllowCommon admits passwords on AuthKit's embedded common-password blocklist, which the zero value refuses.
AUTH_PASSWORD_ALLOW_COMMON=false
# RandomNames is the app's pool for generated usernames.
AUTH_USERNAME_RANDOM_NAMES=
# MinLength and MaxLength bound the length; 0 defaults to 4 and 30, and MaxLength is at most 64.
AUTH_USERNAME_MIN_LENGTH=
# MinLength and MaxLength bound the length; 0 defaults to 4 and 30, and MaxLength is at most 64.
AUTH_USERNAME_MAX_LENGTH=
# Renames lets users change their own username; off by default.
AUTH_USERNAME_RENAMES=false
# RenameInterval is the least time between two renames of one account.
AUTH_USERNAME_RENAME_INTERVAL=
# Mode is NameRetentionFinite, NameRetentionForever or NameRetentionImmediate.
AUTH_USERNAME_FORMER_NAMES_MODE=
# Duration is how long a finite reservation lasts; 0 defaults to 90 days.
AUTH_USERNAME_FORMER_NAMES_DURATION=
# Mode is NameRetentionFinite, NameRetentionForever or NameRetentionImmediate.
AUTH_USERNAME_DELETED_NAMES_MODE=
# Duration is how long a finite reservation lasts; 0 defaults to 90 days.
AUTH_USERNAME_DELETED_NAMES_DURATION=
# Mode is NameRetentionFinite, NameRetentionForever or NameRetentionImmediate.
AUTH_TENANTS_FORMER_NAMES_MODE=
# Duration is how long a finite reservation lasts; 0 defaults to 90 days.
AUTH_TENANTS_FORMER_NAMES_DURATION=
# TOTPIssuer is the service label in authenticator apps.
AUTH_TWO_FACTOR_TOTP_ISSUER=
# Mode is the account-wide policy: iam.TwoFactorDisabled, iam.TwoFactorOptional (the default) or iam.TwoFactorRequired (every user enrolls before normal session use).
AUTH_TWO_FACTOR_MODE=
# Methods are the enabled second-factor channels; empty enables email, SMS and TOTP.
AUTH_TWO_FACTOR_METHODS=
# TOTPSecretKey encrypts stored authenticator-app secrets: 16, 24 or 32 raw bytes.
AUTH_TWO_FACTOR_TOTP_SECRET_KEY=
# AuthKit's auth.passkeys.rp_id.
AUTH_PASSKEYS_RP_ID=
# AuthKit's auth.passkeys.rp_display_name.
AUTH_PASSKEYS_RP_DISPLAY_NAME=
# AuthKit's auth.passkeys.origins.
AUTH_PASSKEYS_ORIGINS=
# Normalized to required: passkey sign-in supplies MFA only with PIN/biometric UV.
AUTH_PASSKEYS_USER_VERIFICATION=
# Enabled mounts RouteDeviceKeys and lets the engine run enrollment and login ceremonies.
AUTH_DEVICE_KEYS_ENABLED=false
# Prefix brands generated keys (one per deployment): lowercase alphanumeric, 1-16 characters.
AUTH_API_KEYS_PREFIX=
# MaxTTL caps how far ahead a key may expire; a later or absent expiry is capped at creation.
AUTH_API_KEYS_MAX_TTL=
# AuthKit's auth.personal_access_tokens.enabled.
AUTH_PERSONAL_ACCESS_TOKENS_ENABLED=false
# AuthKit's auth.personal_access_tokens.default_ttl.
AUTH_PERSONAL_ACCESS_TOKENS_DEFAULT_TTL=
# AuthKit's auth.personal_access_tokens.max_ttl.
AUTH_PERSONAL_ACCESS_TOKENS_MAX_TTL=
# Clients are the registered OAuth clients.
AUTH_AUTHORIZATION_SERVER_CLIENTS=
# Resources are the resource servers access tokens may be minted for (RFC 8707 resource indicators).
AUTH_AUTHORIZATION_SERVER_RESOURCES=
# AccessTokenTTL is the lifetime of the RFC 9068 access tokens it mints, and those a resource server (Config.Resource) mints for its remote applications' assertions, which may set it with no Clients.
AUTH_AUTHORIZATION_SERVER_ACCESS_TOKEN_TTL=
# RefreshTokenTTL bounds a refresh token family: rotation never extends it, and the client signs the user in again (prompt=none) after it.
AUTH_AUTHORIZATION_SERVER_REFRESH_TOKEN_TTL=
# Scopes are the scopes a group client may request beyond OpenID's (openid, email, phone, profile), each for one resource, with the description the consent screen shows.
AUTH_AUTHORIZATION_SERVER_GROUP_CLIENTS_SCOPES=
# Agreements are keys of Config.Agreements a user accepts, at their current versions, before approving any group client.
AUTH_AUTHORIZATION_SERVER_GROUP_CLIENTS_AGREEMENTS=
# PairwiseSubjects gives each user a different sub, and sid, at each group's clients (OIDC Core §8.1, the group as the sector), so groups cannot join their users: in ID tokens, userinfo, access tokens and logout tokens.
AUTH_AUTHORIZATION_SERVER_GROUP_CLIENTS_PAIRWISE_SUBJECTS=false
# ID is the resource identifier (RFC 8707): an accepted access token's aud must contain it.
AUTH_RESOURCE_ID=
# PublicURL is where clients reach the API, the origin a DPoP proof's htu names (RFC 9449 §4.3): "https://api.example.com", or with the path a proxy strips.
AUTH_RESOURCE_PUBLIC_URL=
# Scopes are the resource's scopes and the permission ceiling each one grants (RFC 6749 §3.3), as grant patterns: an access token's permissions count only within the ceilings of the scopes it was granted.
AUTH_RESOURCE_SCOPES=
# Disabled turns them off: no invitation is issued or honoured.
AUTH_INVITATIONS_DISABLED=false
# Targets are the service providers.
AUTH_PROVISIONING_TARGETS=
# ReconcileInterval is how often each target's users are listed and compared with the accounts, repairing what drifted; 0 defaults to a day, under a second is a second, and a negative value turns reconciliation off.
AUTH_PROVISIONING_RECONCILE_INTERVAL=
# RemoteApplications declares the remote applications root controls, as the whole set: New registers each one and disables any this deployment declared at an earlier boot and no longer does.
AUTH_REMOTE_APPLICATIONS=
# Supported are the languages requests may select; empty accepts any.
AUTH_LANGUAGES_SUPPORTED=
# Default is the language when neither the account nor the request chooses one; empty defaults to "en".
AUTH_LANGUAGES_DEFAULT=
# SolanaNetwork turns on Sign In With Solana for one chain; the zero value leaves it off.
AUTH_SOLANA_NETWORK=
# SenderHealthInterval is how often Start re-runs the senders' CheckHealth; 0 defaults to five minutes.
AUTH_SENDER_HEALTH_INTERVAL=
# SenderHealthRecheck is how soon a sender is checked again after its first failed check, or after a failed send, instead of waiting SenderHealthInterval; once two checks in a row have failed, checks return to SenderHealthInterval.
AUTH_SENDER_HEALTH_RECHECK=
# SessionEventRetention is how long session-event history rows (sign-ins and revocations, with IP and user agent: personal data) are kept.
AUTH_SESSION_EVENT_RETENTION=
# EventRetention keeps committed account/group events independently of readers.
AUTH_EVENT_RETENTION=
# CleanupInterval is how often expired auth state is cleaned up; 0 defaults to one hour.
AUTH_CLEANUP_INTERVAL=
# Groups selects the mounted route groups.
AUTH_HTTP_GROUPS=
# BasePath roots the whole surface.
AUTH_HTTP_BASE_PATH=
# APIPath is the JSON API's prefix beneath BasePath; AuthKit adds the version segment, /v1, after it.
AUTH_HTTP_API_PATH=
# PublicURL is where clients reach BasePath when a proxy in front changes the origin or the path, such as "https://shop.example.com/sso".
AUTH_HTTP_PUBLIC_URL=
# Exclude drops routes the host serves itself, named as iam.Route.Pattern names them ("GET /.well-known/jwks.json").
AUTH_HTTP_EXCLUDE=
# RefreshCookie delivers the rotating refresh token as an HttpOnly cookie (iam.RefreshCookieName) instead of a JSON field.
AUTH_HTTP_REFRESH_COOKIE=false
# RefreshCookieName overrides the base label.
AUTH_HTTP_REFRESH_COOKIE_NAME=
# RedisKeyPrefix namespaces the rate-limit keys in Deps.Redis so deployments can share one Redis.
AUTH_HTTP_REDIS_KEY_PREFIX=
# TrustedProxies are the CIDRs of reverse proxies whose X-Forwarded-For is honoured.
AUTH_HTTP_TRUSTED_PROXIES=
# CloudflareProxies are Cloudflare's egress ranges: X-Forwarded-For plus CF-Connecting-IP.
AUTH_HTTP_CLOUDFLARE_PROXIES=
# DirectPeerIP asserts nothing sits in front: RemoteAddr is the client.
AUTH_HTTP_DIRECT_PEER_IP=false

# --- admin_console ---
# Disabled omits the console's pages, assets and bootstrap endpoints.
ADMIN_CONSOLE_DISABLED=false
# Issuers are keyed by a merchant id or name, or "root" for operators.
ADMIN_CONSOLE_ISSUERS=

# --- redis ---
# URL is redis://[user[:password]@]host[:port][/db], or rediss:// over TLS.
REDIS_URL=
# CACert is the PEM bundle of the CA that signed the server's certificate, for a rediss:// URL; unset, the system roots.
REDIS_CA_CERT=

# --- clickhouse ---
# URL is clickhouse://[user[:password]@]host[:port][/database], port 9000 by default; the path names the event store's database, openrails by default.
CLICKHOUSE_URL=

# --- email_smtp ---
# Host is the SMTP server; empty sends no email.
EMAIL_SMTP_HOST=
# Port is the server's port: 465 is implicit TLS, others STARTTLS.
EMAIL_SMTP_PORT=
# Username is the SMTP login.
EMAIL_SMTP_USERNAME=
# Password is the login's password.
EMAIL_SMTP_PASSWORD=
# From is the deployment's own mailbox.
EMAIL_SMTP_FROM=

# --- logger ---
# Level is debug, info, warn or error; unset is info.
LOGGER_LEVEL=info
