# Every environment variable the openrails binary reads: a reference, read by
# nothing. Generated from the configuration types; regenerate with
# `go run ./internal/examplegen -write` in server/. Each value is the default
# (empty: none) and each secret is empty. A variable is its config.yaml key,
# upper-cased and joined by "_"; a list is comma-separated, a section or a
# list of sections JSON. A variable inside a known section that names no key
# refuses boot. Policy (rate_limits, user_action_rate_limit,
# destructive_action_limits) is set in config.yaml only. A merchant's settings
# are no variables: its document is merchant.example.yaml.

# --- process ---
# The configuration file when --config names none; also config/ is searched.
OPENRAILS_CONFIG=config.yaml
# The directory of mounted secret files, each named like its variable; vault.secrets_path defaults to it.
VAULT_SECRETS_PATH=/vault/secrets

# --- top level ---
# EngineAdmissionHold pauses new renewal obligations, never receipt recovery.
ENGINE_ADMISSION_HOLD=false
# PublicBillingBaseURL is the external billing mount, excluding /v1.
PUBLIC_BILLING_BASE_URL=http://localhost:3053
# TrustedProxies are the CIDRs whose X-Forwarded-For is trusted when resolving a client's address.
TRUSTED_PROXIES=
# CheckoutOrigin is needed only to serve OpenRails's own hosted pay page: the separate origin (https://pay.example.com) where /pay/<order> is served from Deps.CheckoutAssets; leave it empty when you use the embedded checkout or your own card form, and pay URLs then answer pay_url_unavailable.
CHECKOUT_ORIGIN=
# Host and Port are where Run and Serve listen.
HOST=0.0.0.0
# Host and Port are where Run and Serve listen.
PORT=3053
# MetricsPort is where Run and Serve also serve MetricsHandler, the operator's Prometheus /metrics, on Host, apart from the public surface.
METRICS_PORT=

# --- database ---
# Schema holds OpenRails' tables: a plain identifier.
DATABASE_SCHEMA=billing
# RiverSchema holds the River tables OpenRails' jobs run in; empty is Schema plus "_river", apart from AuthKit's and the host's River.
DATABASE_RIVER_SCHEMA=billing_river
# SkipMigrations makes New validate existing schemas without applying migrations: a migration that is missing, or was applied with other content, is ErrMigrationsRequired.
DATABASE_SKIP_MIGRATIONS=false
# LeaseConns caps the separate pool, copied from Deps.Postgres's configuration, that renews leases: idempotency claims, the billing pass and merchant pulls.
DATABASE_LEASE_CONNS=4
# URL is the connection string; it overrides the parts below.
DATABASE_URL=postgres://app:app_password@localhost:5434/openrails_db?sslmode=disable
# Host is the database server, when URL is unset.
DATABASE_HOST=
# Port is the database server's port.
DATABASE_PORT=
# Name is the database.
DATABASE_NAME=
# Username is the role the server connects, migrates and runs as.
DATABASE_USERNAME=
# Password is the role's password.
DATABASE_PASSWORD=
# SSLMode is libpq's sslmode for the parts: verify-full by default, require for a loopback host or a Unix socket.
DATABASE_SSLMODE=
# SSLRootCert is the PEM file of the CAs that verify the server's certificate; unset, the system roots.
DATABASE_SSLROOTCERT=
# SQLTrace logs every query at debug level.
DATABASE_SQL_TRACE=false

# --- clickhouse ---
# Database holds the event store's tables.
CLICKHOUSE_DATABASE=openrails
# Addr is host:port of the native protocol, 9000 by default.
CLICKHOUSE_ADDR=
# Username is the ClickHouse user.
CLICKHOUSE_USERNAME=default
# Password is the user's password.
CLICKHOUSE_PASSWORD=

# --- captcha ---
# Provider is "turnstile", "recaptcha-v3" or "hcaptcha".
CAPTCHA_PROVIDER=turnstile
# SiteKey is the account's public key, which the browser's widget loads.
CAPTCHA_SITE_KEY=
# SecretKey is the account's secret, which verifies a solved challenge.
CAPTCHA_SECRET_KEY=

# --- vault ---
# KVMount is the KV v2 mount merchant configuration lives in, under ScopePrefix.
VAULT_KV_MOUNT=
# ScopePrefix is the path under KVMount.
VAULT_SCOPE_PREFIX=openrails
# TransitMount is the Transit mount Solana signing keys live under.
VAULT_TRANSIT_MOUNT=transit
# Address is the server URL (VAULT_ADDR); empty is Vault's default, https://127.0.0.1:8200.
VAULT_ADDR=
# Namespace is a Vault Enterprise namespace.
VAULT_NAMESPACE=
# CACert is the path of the PEM bundle of the CA that signed Vault's certificate (VAULT_CACERT).
VAULT_CACERT=
# AuthMethod is "token", "approle" or "kubernetes".
VAULT_AUTH_METHOD=
# Token is a pre-issued Vault token.
VAULT_TOKEN=
# RoleID is the AppRole role id.
VAULT_ROLE_ID=
# SecretID is the AppRole secret id, when SecretsPath holds none.
VAULT_SECRET_ID=
# K8sRole is the kubernetes auth method's role.
VAULT_K8S_ROLE=
# AuthMount is where the approle or kubernetes auth method is mounted: the -path of `vault auth enable`, without auth/.
VAULT_AUTH_MOUNT=

# --- card_vault ---
# Kind is the vault vendor: basis_theory.
CARD_VAULT_KIND=
# TenantID is the vendor's tenant id.
CARD_VAULT_TENANT_ID=
# KVMount holds the platform credential document.
CARD_VAULT_KV_MOUNT=

# --- hyperswitch ---
# AllowLoopbackHTTP admits an http loopback fixture; refused beside a live PSP.
HYPERSWITCH_ALLOW_LOOPBACK_HTTP=false
# APIBaseURL is the deployment's HyperSwitch API.
HYPERSWITCH_API_BASE_URL=
# SDKURL is the HyperSwitch browser SDK the payment page loads.
HYPERSWITCH_SDK_URL=

# --- solana ---
# Crankers sign Solana rebilling, in order: the first publishes new plans, and each pulls the renewals of the plans it owns, whose owner is fixed on-chain.
SOLANA_CRANKERS=

# --- llm ---
# Provider selects the API dialect: "anthropic" (when empty) or "openai".
LLM_PROVIDER=
# Model is the provider's model ID; empty is the provider's default.
LLM_MODEL=
# BaseURL replaces the provider's public endpoint: an absolute https URL.
LLM_BASE_URL=
# APIKey is the provider credential.
LLM_API_KEY=
# CatalogCopilotEnabled turns on read-only questions about the catalog, which send aggregate catalog and subscriber counts to the provider.
LLM_CATALOG_COPILOT_ENABLED=false
# CatalogDraftingEnabled lets the catalog copilot draft price and catalog changes.
LLM_CATALOG_DRAFTING_ENABLED=false

# --- provider_sandbox ---
# NMIGatewayURL replaces the NMI sandbox endpoints.
PROVIDER_SANDBOX_NMI_GATEWAY_URL=
# StripeAPIURL replaces the Stripe API root.
PROVIDER_SANDBOX_STRIPE_API_URL=
# SolanaRPCURL replaces every merchant's Solana RPC endpoint.
PROVIDER_SANDBOX_SOLANA_RPC_URL=
# CCBillDataLinkURL replaces the CCBill DataLink endpoint.
PROVIDER_SANDBOX_CCBILL_DATALINK_URL=
# CCBillWebhookSources are extra source CIDRs accepted as a sandbox CCBill account's webhook origins.
PROVIDER_SANDBOX_CCBILL_WEBHOOK_SOURCES=

# --- auth ---
# Path is the directory holding AuthKit's signing keys (keys.json) and its authenticator-app key (totp.key).
AUTH_KEYS_PATH=/vault/auth

# --- naming ---
# Enabled lets a merchant rename itself.
NAMING_ENABLED=true
# RenameInterval is how long a merchant waits between renames; 0s is at once.
NAMING_RENAME_INTERVAL=72h
# Mode is finite, forever or immediate.
NAMING_FORMER_NAMES_MODE=finite
# Duration is how long a finite former name forwards.
NAMING_FORMER_NAMES_DURATION=2160h

# --- route_groups ---
# Admin is customer support (/v1/admin): customers, their subscriptions, payments, refunds, orders, credits, access and usage.
ROUTE_GROUPS_ADMIN=false
# Catalog is the catalog: products, prices, meters and their rates, archiving a product, applying a catalog document, moving subscribers between prices.
ROUTE_GROUPS_CATALOG=false
# MerchantConfig is the merchant's own configuration: PSPs, settings, billing import and export, the dashboard layout.
ROUTE_GROUPS_MERCHANT_CONFIG=false
# Metrics is the merchant's business metrics, read-only: revenue, sales, the metrics queries and the dashboard.
ROUTE_GROUPS_METRICS=false
# Programmatic is the routes the host's backend calls over HTTP at /v1/app: entitlement checks, usage and admissions, provider operations, host events and SCIM provisioning.
ROUTE_GROUPS_PROGRAMMATIC=false

# --- admin_console ---
# Disabled omits the console's pages, assets and bootstrap endpoints.
ADMIN_CONSOLE_DISABLED=false

# --- redis ---
# Addr is host:port.
REDIS_ADDR=
# URL is redis://[user[:password]@]host[:port][/db], or rediss:// over TLS, in place of Addr, DB and TLS.
REDIS_URL=
# Username is the ACL user; empty is the default user.
REDIS_USERNAME=
# Password is the user's password.
REDIS_PASSWORD=
# DB is the database number.
REDIS_DB=
# TLS connects over TLS, verifying the server against the system roots, or against CACert, which implies TLS.
REDIS_TLS=false
# CACert is the PEM bundle of the CA that signed the server's certificate.
REDIS_CA_CERT=

# --- email_smtp ---
# Host is the SMTP server; empty sends no email.
EMAIL_SMTP_HOST=
# Port is the server's port: 465 is implicit TLS, others STARTTLS.
EMAIL_SMTP_PORT=
# Username is the SMTP login.
EMAIL_SMTP_USERNAME=
# Password is the login's password.
EMAIL_SMTP_PASSWORD=
# From is the deployment's own mailbox.
EMAIL_SMTP_FROM=

# --- signing_key ---
# ActiveKeyID is the signing key's kid.
AUTHKIT_ACTIVE_KEY_ID=
# ActivePrivateKeyPEM is the signing key, PEM.
AUTHKIT_ACTIVE_PRIVATE_KEY_PEM=
# PublicKeysJSON is a JSON object {kid: PEM} of further keys trusted for verification.
AUTHKIT_PUBLIC_KEYS=

# --- logger ---
# Level is debug, info, warn or error; unset is info.
LOGGER_LEVEL=info
# Format is json or text; unset is json.
LOGGER_FORMAT=json
