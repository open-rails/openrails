# OpenRails environment variables: a reference, read by nothing. `openrails
# run-server` needs none against the Compose dependencies
# (`docker compose up -d postgres garnet`); docs/standalone.md's configuration
# reference lists every key and its default. A key's variable is its path
# upper-cased and joined by "_" (database.url is DATABASE_URL); a variable inside a known
# section that names no key refuses boot.

# --- Where the server is reached (default http://localhost:3053) ---
# PORT=3053
# PUBLIC_BILLING_BASE_URL=https://billing.example.com

# --- PostgreSQL (default: Compose's, on localhost:5434) ---
# DATABASE_URL=postgres://openrails:secret@db.example.com:5432/openrails

# --- Redis: share rate limits between instances (default: none, in memory) ---
# REDIS_ADDR=localhost:6380

# --- The event store usage needs (default: none, usage off) ---
# CLICKHOUSE_ADDR=localhost:9000

# --- The server's AuthKit ---
# A deployed server names its account directory: generate a UUID once.
# AUTH_DEFAULT_TENANT_ID=
# AUTH_KEYS_PATH=/vault/auth

# --- Vault: merchant configuration and Solana signing ---
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_KV_MOUNT=kv

# --- Email (any SMTP server; an empty host sends none) ---
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_FROM="Billing <billing@example.com>"

# --- Logging (default info, json) ---
# LOGGER_LEVEL=debug
# LOGGER_FORMAT=text
